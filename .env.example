# Copy these into your hosting provider's Environment Variables settings.
# Never commit real values. .env files are already in .gitignore.

# Zoho Mail SMTP (paid organisation account, India data centre)
SMTP_HOST=smtppro.zoho.in
# 465 = SSL, 587 = TLS
SMTP_PORT=465
# The Zoho mailbox you log in with (it must really exist; aliases cannot log in).
SMTP_USER=contact@hydholidays.com
# Zoho app-specific password: accounts.zoho.in > Security > App Passwords
SMTP_PASS=your-zoho-app-password

# Sender and recipient
MAIL_FROM=contact@hydholidays.com
MAIL_FROM_NAME=Hyderabad Holidays Co. Website
MAIL_TO=contact@hydholidays.com

# Only these sites may post enquiries (comma-separated, no trailing slash)
ALLOWED_ORIGINS=https://hydholidays.com,https://www.hydholidays.com,https://hydholidays-website.vercel.app
