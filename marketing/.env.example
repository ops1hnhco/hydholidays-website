# Settings for the WhatsApp offers agent (whatsapp.js). Copy to marketing/.env and fill in.
# .env is never committed.

# console.anthropic.com → API Keys (the same key as the GitHub secret is fine)
ANTHROPIC_API_KEY=

# Your WhatsApp number, with country code: offers are sent here for approval
WA_OWNER=917075040406

# Exact names of the supplier groups to read, separated by commas.
# Run "npm run whatsapp -- --groups" to see the names.
WA_GROUPS=

# Added to the supplier's price, then rounded up to the next ₹100
MARKUP_PERCENT=10

# When to read the groups and send offers, in IST (24-hour HH:MM)
DIGEST_TIMES=11:00,17:00

# GitHub fine-grained token for this repository with "Actions: Read and write" (see README)
GITHUB_TOKEN=
GITHUB_REPO=ops1hnhco/hydholidays-website

# 1 = start the workflows as dry runs: nothing is published (for testing)
PUBLISH_DRY_RUN=1
